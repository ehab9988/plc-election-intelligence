# Copy to .env and fill in real values before running docker compose / the API locally.
# NEVER commit a real .env file.

PRODUCT_NAME="PLC Election Intelligence"
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://plc:plc@localhost:5432/plc_election
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# NLP_PROVIDER selects which PoliticalNlpProvider the ingestion pipeline
# uses to extract structured entities/events/relationships from news
# articles (see docs/DATA_SOURCES.md and services/ingestion/ingestion/nlp/).
# It is an extraction ASSISTANT only — high-impact changes (coalition
# formation, withdrawals, disqualifications) still require analyst review
# or an authoritative source before becoming a verified fact (section 53).
NLP_PROVIDER=rules
# NLP_PROVIDER=anthropic_compatible
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# NLP_PROVIDER=openai_compatible
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# OPENAI_API_KEY (above) also independently enables AI-driven news/poll/
# party/coalition-likelihood DISCOVERY (services/ingestion/ingestion/
# sources/openai_search_adapter.py, poll_discovery.py, party_discovery.py,
# coalition_likelihood.py) — the ingestion cycle searches the web itself
# for recent Palestinian election news, polls, electoral lists/parties,
# and coalition-formation signals, so no per-outlet feed_url needs to be
# configured. No separate URL is needed for this — leave OPENAI_BASE_URL
# unset unless you're pointing at a non-OpenAI endpoint. This is
# independent of NLP_PROVIDER above (which only controls how
# already-fetched article text gets structured-fact extraction).
#
# Product decision: none of this has a human review step. Discovered
# polls are written as manually_verified=True immediately and DO move
# the published forecast on the next recompute — see poll_discovery.py's
# module docstring for the accuracy tradeoff this implies and the
# automated (non-human) sanity checks that remain. Discovered electoral
# lists/parties are still never assigned a registration status stronger
# than "considering" from AI alone (party_discovery.py) — that clamp is
# about not asserting a legal/official outcome the AI can't actually
# confirm, not about requiring a human. Coalition-formation likelihood
# estimates (coalition_likelihood.py) are explicitly labeled as AI
# estimates everywhere they're shown, never presented as a calibrated
# statistic — see docs/COALITION_MODEL.md.

# How often the ingestion scheduler (services/ingestion/ingestion/scheduler.py)
# polls sources and re-checks whether a new forecast run is warranted.
# Requires deploying the Celery worker + beat schedule — see
# docs/DEPLOYMENT.md "24/7 ingestion & forecasting" — this repo's
# development sandbox cannot run a persistent background process.
INGESTION_POLL_INTERVAL_MINUTES=15
FORECAST_RECOMPUTE_INTERVAL_MINUTES=60

DEFAULT_MONTE_CARLO_SIMULATIONS=20000

# Licensed/commercial news API credentials (optional, per source adapter)
# NEWSAPI_KEY=
# LICENSED_FEED_TOKEN=

# Google Play Billing (Android) — configure in-app; server-side verification key:
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# External checkout provider (Windows) — replaceable, pick one:
# STRIPE_SECRET_KEY=
# PADDLE_API_KEY=
